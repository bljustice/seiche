export component SegmentedControl inherits Rectangle {
    in property <[string]> options: ["A", "B"];
    in-out property <int> current-index: 0;
    callback selected(int);

    HorizontalLayout {
        spacing: 4px;
        alignment: center;

        for opt[i] in root.options: Rectangle {
            min-width: 72px;
            height: 28px;
            border-radius: 4px;
            background: root.current-index == i ? #000000 : #ffffff;
            border-width: 1px;
            border-color: #000000;

            Text {
                text: opt;
                color: root.current-index == i ? #ffffff : #000000;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                clicked => {
                    root.current-index = i;
                    root.selected(i);
                }
            }
        }
    }
}
